# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Algorand node (Algonode is free and requires no API key)
ALGOD_URL=https://mainnet-api.algonode.cloud
INDEXER_URL=https://mainnet-idx.algonode.cloud

# Optional: Nodely API key for higher rate limits
NODELY_API_KEY=

# Frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Budget helper app ID (deploy budget_helper.py once and put the app ID here)
VITE_BUDGET_HELPER_APP_ID=

# Test suite — funded testnet accounts (never use mainnet accounts here)
# Generate: python -c "from algosdk import account, mnemonic; pk, addr = account.generate_account(); print(addr); print(mnemonic.from_private_key(pk))"
# Fund at: https://bank.testnet.algorand.network/
TEST_USER1_MNEMONIC=word1 word2 word3 ... word25
TEST_USER2_MNEMONIC=word1 word2 word3 ... word25
TEST_USER3_MNEMONIC=word1 word2 word3 ... word25
TEST_USER4_MNEMONIC=  # optional, defaults to TEST_USER1_MNEMONIC
