# Operator/server only. Never commit real values or expose them as VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Obtain the exact ID and hash from your chosen node's /v2/transactions/params.
ALGOD_URL=http://127.0.0.1:4001
ALGOD_TOKEN=
ALGOD_TOKEN_HEADER=X-Algo-API-Token
INDEXER_URL=http://127.0.0.1:8980
INDEXER_TOKEN=
INDEXER_TOKEN_HEADER=X-Indexer-API-Token
ALGORAND_GENESIS_ID=
ALGORAND_GENESIS_HASH=

# Comma-separated exact frontend origins; no wildcard matching.
FRONTEND_ORIGINS=http://localhost:5173

# Edge Function secret only. Its address must match the configured publisher.
PUBLISHER_MNEMONIC=
# Both scheduler and Edge publisher must explicitly enable publication.
FUNDED_REWARDS_PUBLICATION_ENABLED=false
